# PatiMati Frontend — TÜM MODLARDA yüklenen varsayılanlar
#
# Vite bu klasördeki env dosyalarını şu sırayla okur, SONRAKİ öncekini ezer:
#     .env  ->  .env.local  ->  .env.<mod>  ->  .env.<mod>.local
# Yalnızca VITE_ önekli değişkenler istemci paketine girer — yani buradaki her
# değer TARAYICIYA GİDER ve herkese açıktır. Gizli kalması gereken hiçbir şey
# (API parolası, servis hesabı, özel anahtar) bu dosyalara YAZILMAZ.
#
# Buradaki adresler yerel geliştirme içindir; üretimde .env.production ezer.

VITE_API_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080

# AI servisi (yerel). Şu an istemci kodunda kullanılmıyor, ileride bağlanacak.
VITE_AI_BASE_URL=http://localhost:8000

# --- Firebase (web istemcisi: patim-25976) ---
