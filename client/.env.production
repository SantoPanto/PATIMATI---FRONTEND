# PatiMati Frontend Production Environment
#
# 1. Domain tabanlı backend kullanımı için (örn: https://patimati.me):
VITE_API_URL=https://patimati.me

# 2. Nginx reverse proxy ile göreceli yol (relative path) kullanımı için:
# VITE_API_URL= boş bırakıldığında tüm istekler relative (/api/..., /oauth2/...) olarak iletilir.
# VITE_API_URL=
