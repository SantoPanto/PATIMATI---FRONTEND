# Frontend environment variables example

# Primary backend API URL
VITE_API_URL=http://localhost:8080

# Legacy / Fallback backend API URL
VITE_API_BASE_URL=http://localhost:8080

# AI service URL
VITE_AI_BASE_URL=http://localhost:8000

# Optional: if you have a separate image upload service (not used by default)
# VITE_IMAGE_UPLOAD_URL=https://api.imgupload.example/upload
# VITE_IMAGE_UPLOAD_KEY=your-key
